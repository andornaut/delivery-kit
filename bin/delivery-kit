#!/usr/bin/env bash
# Caller-supplied configuration and state stay separate from the pinned mechanism snapshot.
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
usage() {
  echo 'usage: delivery-kit --config ABSOLUTE_FILE --state-dir ABSOLUTE_DIRECTORY [--revision SHA] run|check-config|resource-report|scheduled-once [--scheduled-at EPOCH]|request-once --request-id SAFE_ID|monitor-snapshot --recipient UUID [--parent UUID ...]|monitor-ack --recipient UUID --snapshot UUID --queue-id ID --disposition handled|superseded|retained [--reason REASON]'
}
if (( $# == 1 )) && [[ $1 == --help || $1 == help ]]; then
  usage
  exit 0
fi
CONF=
STATE=
REVISION=
while (( $# )); do
  case "$1" in
    --config|--state-dir|--revision)
      (( $# >= 2 )) || { usage >&2; exit 2; }
      case "$1" in --config) CONF=$2 ;; --state-dir) STATE=$2 ;; --revision) REVISION=$2 ;; esac
      shift 2 ;;
    *) break ;;
  esac
done
[[ $CONF == /* && -r $CONF && $STATE == /* && -d $STATE ]] || { usage >&2; exit 2; }
if [[ -n $REVISION ]]; then
  [[ $REVISION =~ ^[0-9a-f]{40}$ && -f $ROOT/SOURCE_COMMIT ]] || { echo 'delivery: exact source snapshot required' >&2; exit 2; }
  [[ $(cat "$ROOT/SOURCE_COMMIT") == "$REVISION" ]] || { echo 'delivery: source revision mismatch' >&2; exit 2; }
fi
export BUS_CONF=$CONF BUS_STATE_DIR=$STATE
command=${1:-}
(( $# )) && shift
case "$command" in
  run) (( $# == 0 )) || { usage >&2; exit 2; }; exec bash "$ROOT/libexec/runner.sh" ;;
  check-config)
    (( $# == 0 )) || { usage >&2; exit 2; }
    S=$ROOT/libexec
    . "$S/bus-common.sh"
    printf 'delivery: configuration accepted\n'
    ;;
  resource-report) (( $# == 0 )) || { usage >&2; exit 2; }; exec bash "$ROOT/libexec/resource-report.sh" ;;
  request-once)
    (( $# == 2 )) && [[ $1 == --request-id ]] || { usage >&2; exit 2; }
    S=$ROOT/libexec
    . "$S/bus-common.sh"
    exec python3 "$S/request.py" "$BUS_DIR" "$REPO" capture "$2"
    ;;
  monitor-snapshot|monitor-ack)
    S=$ROOT/libexec
    . "$S/bus-common.sh"
    action=snapshot
    [[ $command == monitor-ack ]] && action=ack
    if claude_route_selected; then
      exec "$CLAUDE_PYTHON" "$S/claude_monitor.py" "$action" --state-dir "$BUS_DIR/unblock" \
        --route "$MONITOR_ROUTE_FILE" "$@"
    fi
    codex_python_ready || exit 2
    exec "$CODEX_PYTHON" "$S/monitor.py" "$action" --state-dir "$BUS_DIR/unblock" \
      --control-socket "${CODEX_CONTROL_SOCKET:-}" "$@"
    ;;
  scheduled-once) exec bash "$ROOT/libexec/scheduled-once.sh" "$@" ;;
  *) usage >&2; exit 2 ;;
esac
